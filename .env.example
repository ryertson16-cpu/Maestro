# Cobrança (produção = ligada; no PC de desenvolvimento fica desligada se você omitir)
MAESTRO_BILLING_ENFORCED=false
MAESTRO_PUBLIC_HOST=https://maestro.com.br

# E-mails (separados por vírgula) que abrem /gestao — dono da ferramenta.
# MAESTRO_OWNER_EMAILS=voce@email.com

# Render (produção). O Blueprint gera SECRET_KEY_BASE.
# RAILS_MASTER_KEY= (o valor de config/master.key, só no painel do Render)
# DATABASE_URL= (o Postgres do Render preenche sozinho)

# Asaas (PIX). Sandbox: https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com
ASAAS_WEBHOOK_TOKEN=

# WhatsApp Cloud API
LIRA_WHATSAPP_TOKEN=
LIRA_WHATSAPP_PHONE_NUMBER_ID=
LIRA_WHATSAPP_VERIFY_TOKEN=
LIRA_WHATSAPP_APP_SECRET=

# Cérebro da Lira (um por servidor: openai ou gemini). Sem chave, só comandos.
# A mesma chave lê o nome manuscrito e as bolhas do cartão-resposta ENEM.
LIRA_BRAIN=
LIRA_OPENAI_API_KEY=
LIRA_OPENAI_URL=
LIRA_OPENAI_MODEL=gpt-4o-mini
LIRA_GEMINI_API_KEY=
LIRA_GEMINI_MODEL=gemini-2.5-flash

# Login social (omitir esconde o provedor só depois que a tela for ajustada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
