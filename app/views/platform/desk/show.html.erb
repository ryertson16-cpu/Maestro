<% content_for :title, "Gestão | Maestro" %>

<div class="page-header">
  <div>
    <span class="section-eyebrow">Plataforma</span>
    <h1>Gestão do Maestro</h1>
    <p>
      Venda, teste e acesso dos professores que usam a ferramenta.
      <% if @billing_on %>
        A cobrança do caderno está <strong>ligada</strong>.
      <% else %>
        A cobrança do caderno está <strong>desligada</strong> neste servidor — todo mundo entra, e esta mesa registra o plano na mão.
      <% end %>
      <% if @asaas_on %>
        PIX e cartão Asaas configurados.
      <% else %>
        Asaas ainda não está ligado; libere ou encerre o plano aqui e marque PIX ou cartão na mão.
      <% end %>
    </p>
  </div>
  <div class="page-header-actions">
    <%= link_to "Exportar CSV",
                platform_desk_export_path(desk_filter_params),
                class: "button button-secondary" %>
  </div>
</div>

<section class="attendance-summary" aria-label="Resumo das contas">
  <%= link_to platform_desk_path, class: "desk-kpi-link" do %>
    <article class="summary-card">
      <span class="summary-label">Professores</span>
      <strong><%= @summary[:professors] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "client"), class: "desk-kpi-link" do %>
    <article class="summary-card summary-green">
      <span class="summary-label">Clientes</span>
      <strong><%= @summary[:clients] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "trial"), class: "desk-kpi-link" do %>
    <article class="summary-card summary-justified">
      <span class="summary-label">Teste</span>
      <strong><%= @summary[:trialing] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "complimentary"), class: "desk-kpi-link" do %>
    <article class="summary-card">
      <span class="summary-label">Cortesia</span>
      <strong><%= @summary[:complimentary] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "past_due"), class: "desk-kpi-link" do %>
    <article class="summary-card summary-late">
      <span class="summary-label">Atrasado</span>
      <strong><%= @summary[:past_due] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "canceled"), class: "desk-kpi-link" do %>
    <article class="summary-card summary-absent">
      <span class="summary-label">Encerrado</span>
      <strong><%= @summary[:canceled] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(segment: "due_soon"), class: "desk-kpi-link" do %>
    <article class="summary-card summary-blue">
      <span class="summary-label">Vence em 7 dias</span>
      <strong><%= @summary[:due_soon] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(payment_method: "pix"), class: "desk-kpi-link" do %>
    <article class="summary-card">
      <span class="summary-label">PIX ativo</span>
      <strong><%= @summary[:pix] %></strong>
    </article>
  <% end %>
  <%= link_to platform_desk_path(payment_method: "credit_card"), class: "desk-kpi-link" do %>
    <article class="summary-card">
      <span class="summary-label">Cartão ativo</span>
      <strong><%= @summary[:credit_card] %></strong>
    </article>
  <% end %>
  <article class="summary-card">
    <span class="summary-label">Estimativa mensal</span>
    <strong>R$ <%= number_with_precision(@summary[:monthly_estimate], precision: 2) %></strong>
  </article>
</section>

<% if @desk_inbox.any? %>
  <section class="data-card">
    <div class="section-heading">
      <div>
        <span class="section-eyebrow">WhatsApp comercial</span>
        <h2>Conversas do agente</h2>
        <p>Recados que o n8n gravou neste caderno. O agente fala com o professor; o diário continua na Lira.</p>
      </div>
    </div>
    <div class="desk-due-list">
      <% @desk_inbox.each do |message| %>
        <div class="desk-due-item">
          <div>
            <strong><%= message.name.presence || message.whatsapp_number %></strong>
            <div class="table-secondary-text">
              <%= message.direction_label %>
              · <%= message.whatsapp_number %>
              <% if message.intent.present? %>
                · <%= message.intent %>
              <% end %>
            </div>
          </div>
          <div><%= truncate(message.body, length: 140) %></div>
          <div>
            <%= l(message.created_at, format: :short) %>
            <% if message.professor %>
              · <%= link_to "Ficha", platform_desk_professor_path(message.professor) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="attendance-filter diary-context">
  <h2>Filtrar contas</h2>
  <%= form_with url: platform_desk_path, method: :get, local: true do |form| %>
    <div>
      <%= form.label :q, "Nome, e-mail ou escola" %>
      <%= form.search_field :q, value: @query, placeholder: "Buscar professor" %>
    </div>
    <div>
      <%= form.label :segment, "Grupo" %>
      <%= form.select :segment,
                      [
                        ["Todas", ""],
                        ["Cliente (mensal)", "client"],
                        ["Período de teste", "trial"],
                        ["Cortesia", "complimentary"],
                        ["Pagamento atrasado", "past_due"],
                        ["Encerrada", "canceled"],
                        ["Vence em 7 dias", "due_soon"]
                      ],
                      { selected: @segment } %>
    </div>
    <div>
      <%= form.label :payment_method, "Pagamento" %>
      <%= form.select :payment_method,
                      [
                        ["Todos", ""],
                        ["PIX", "pix"],
                        ["Cartão", "credit_card"]
                      ],
                      { selected: @payment_method } %>
    </div>
    <div>
      <%= form.submit "Abrir" %>
    </div>
  <% end %>
</section>

<% if @due_soon.any? && @segment != "due_soon" %>
  <section class="data-card">
    <div class="section-heading">
      <div>
        <span class="section-eyebrow">Caixa</span>
        <h2>Vencimentos desta semana</h2>
        <p>Contas ativas, em teste ou atrasadas que vencem em até 7 dias.</p>
      </div>
    </div>
    <div class="desk-due-list">
      <% @due_soon.each do |professor| %>
        <% subscription = professor.subscription %>
        <div class="desk-due-item">
          <div>
            <strong><%= professor.name.presence || professor.email %></strong>
            <div class="table-secondary-text"><%= professor.school&.name.presence || professor.email %></div>
          </div>
          <div>
            <%= subscription.label %>
            · <%= subscription.payment_label %>
          </div>
          <div>
            <%= l(subscription.current_period_end, format: :short) if subscription.current_period_end %>
            · <%= link_to "Ficha", platform_desk_professor_path(professor) %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="data-card">
  <div class="section-heading">
    <div>
      <span class="section-eyebrow">Contas</span>
      <h2>Professores</h2>
      <p>Pílulas compactas. Mensal PIX e Mensal cartão marcam o pagamento recebido. A ficha guarda a nota da conta.</p>
    </div>
  </div>

  <% if @accounts.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Professor</th>
            <th>Escola</th>
            <th>Uso</th>
            <th>Plano</th>
            <th>Até</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |professor| %>
            <% subscription = professor.subscription %>
            <tr>
              <td>
                <strong><%= link_to professor.name.presence || professor.email, platform_desk_professor_path(professor) %></strong>
                <div class="table-secondary-text"><%= professor.email %></div>
                <% if professor.platform_operator? %>
                  <span class="status-badge status-verified">Gestor</span>
                <% end %>
                <% if professor.management_note.present? %>
                  <div class="table-secondary-text"><%= truncate(professor.management_note, length: 80) %></div>
                <% end %>
              </td>
              <td><%= professor.school&.name.presence || "—" %></td>
              <td>
                <%= professor.classrooms.size %> turmas
                · <%= professor.students.size %> alunos
              </td>
              <td>
                <% if subscription %>
                  <span class="status-badge status-<%= desk_status_badge(subscription.status) %>">
                    <%= subscription.label %>
                  </span>
                  <div class="table-secondary-text">
                    <%= subscription.payment_label %>
                    <% if professor.maestro_full_access? %>
                      · caderno pleno
                    <% else %>
                      · caderno bloqueado
                    <% end %>
                  </div>
                <% else %>
                  —
                <% end %>
              </td>
              <td>
                <% if subscription&.current_period_end.present? %>
                  <%= l(subscription.current_period_end, format: :short) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td>
                <% if professor.platform_operator? %>
                  <span class="table-secondary-text">Acesso permanente</span>
                <% else %>
                  <%= render "platform/desk/actions", professor: professor, subscription: subscription %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <section class="empty-state">
      <strong>Nenhuma conta neste filtro.</strong>
      <p>Quando um professor se cadastrar, a conta aparece aqui no período de teste.</p>
    </section>
  <% end %>
</section>

<section class="data-card">
  <div class="section-heading">
    <div>
      <span class="section-eyebrow">Histórico</span>
      <h2>Últimos movimentos</h2>
      <p>PIX e cartão do Asaas e alterações feitas nesta mesa.</p>
    </div>
  </div>

  <% if @recent_events.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Quando</th>
            <th>Tipo</th>
            <th>Professor</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_events.each do |event| %>
            <tr>
              <td><%= l(event.created_at, format: :short) %></td>
              <td><%= event.event_type %></td>
              <td><%= event.professor&.email || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="table-secondary-text">Ainda não há eventos de cobrança.</p>
  <% end %>
</section>
