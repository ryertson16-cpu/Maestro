<% content_for :title, "Corrigir #{@activity.title} | Maestro" %>

<section class="correction-card">
  <p class="correction-kicker">Gabarito · <%= @classroom.name %></p>
  <h1><%= @activity.title %></h1>
  <p><%= @activity.activity_type %> · <%= @activity.bimester_label %></p>
</section>

<% unless request.ssl? || %w[localhost 127.0.0.1 ::1].include?(request.host) %>
  <p class="correction-flash is-warn">
    Esta página está em HTTP. A câmera do celular não liga assim — volte ao
    computador, copie o link HTTPS e cole no Chrome ou no Safari.
  </p>
<% end %>

<% if @just_graded && @student && @score.present? %>
  <section class="correction-score" aria-live="polite">
    <p class="correction-kicker">Gabarito corrigido</p>
    <p>Nota de <%= @student.name %></p>
    <strong><%= format("%.1f", @score).tr(".", ",") %></strong>
    <p>A nota já está no caderno. A foto ficou no Maestro, não na galeria do celular.</p>
    <% if @submission&.marked_photo&.attached? || @submission&.card_photo&.attached? %>
      <figure class="correction-marked-card">
        <%= image_tag url_for(@submission.marked_photo.attached? ? @submission.marked_photo : @submission.card_photo),
                      alt: "Cartão de #{@student.name} com acertos e erros" %>
        <figcaption>
          Verde: pintou a certa. Vermelho: a certa ficou vazia. Azul: questão em branco.
        </figcaption>
      </figure>
    <% end %>
    <%= link_to "Corrigir próximo aluno",
                gabarito_path(@activity.correction_token),
                class: "button button-primary button-block" %>
  </section>
<% elsif @student %>
  <section class="correction-card">
    <p class="correction-kicker">Aluno</p>
    <h2><%= @student.name %></h2>
    <% if @assignment %>
      <p class="activity-type-hint">Folha <%= @assignment.slot %> · só o professor vê este grupo</p>
    <% end %>
    <%= link_to "Trocar aluno", gabarito_path(@activity.correction_token), class: "correction-switch" %>
  </section>

  <% if @lira_ready %>
    <section class="correction-card">
      <p class="correction-kicker">Correção automática</p>
      <h2>Apontar para o cartão</h2>
      <p>
        Aponte para o QR pequeno impresso no cartão. O Maestro fotografa sozinho,
        lê as bolhas e guarda a foto só no caderno. Folha <%= @assignment&.slot || "—" %>.
      </p>
      <div class="qr-scanner-card"
           data-qr-scanner
           data-qr-grade
           data-scan-url="<%= gabarito_scan_path(@activity.correction_token) %>"
           data-correction-pin="<%= @activity.ensure_correction_pin! %>"
           data-student-id="<%= @student.id %>">
        <%= form_with url: gabarito_scan_path(@activity.correction_token),
                      method: :post,
                      local: true,
                      html: { multipart: true, class: "qr-photo-form" } do %>
          <%= hidden_field_tag :student_id, @student.id %>
          <label class="button button-primary button-block">
            Fotografar cartão
            <input class="visually-hidden"
                   type="file"
                   name="card"
                   accept="image/*"
                   capture="environment"
                   data-qr-file>
          </label>
        <% end %>
        <button type="button" class="button button-secondary button-block" data-qr-start>
          Usar câmera na tela
        </button>
        <video data-qr-video playsinline webkit-playsinline muted hidden></video>
        <p class="correction-scan-banner is-wait" data-qr-status role="status">
          Toque em Fotografar cartão. A Câmera do celular tira a foto e o Maestro lê as bolhas.
        </p>
      </div>
    </section>
  <% end %>

  <% if @photo_review %>
    <p class="correction-flash is-warn">Confira as letras lidas abaixo e toque em Lançar nota.</p>
  <% end %>

  <%= form_with url: gabarito_grade_path(@activity.correction_token),
                method: :post,
                local: true,
                class: "correction-form" do %>
    <%= hidden_field_tag :student_id, @student.id %>

    <% Array(@presented).each do |row| %>
      <% item = row.item %>
      <fieldset class="correction-item">
        <legend>
          <%= row.number %>. <%= item.prompt %>
          <% if item.bncc_skill.present? %>
            <small>BNCC <%= item.bncc_skill %></small>
          <% end %>
        </legend>
        <%= render "questions/figure", image: item.image %>
        <% if item.objective? %>
          <div class="correction-keys">
            <% row.pairs.each do |letter, _text| %>
              <label class="correction-key">
                <%= radio_button_tag "answers[#{item.id}]",
                                     letter,
                                     @answers[item.id.to_s].to_s == letter %>
                <span><%= letter %></span>
              </label>
            <% end %>
          </div>
        <% else %>
          <label class="correction-discursive">
            Pontos (máx. <%= format("%.1f", item.points).tr(".", ",") %>)
            <%= number_field_tag "answers[#{item.id}]",
                                 @answers[item.id.to_s],
                                 min: 0,
                                 max: item.points,
                                 step: 0.1,
                                 inputmode: "decimal" %>
          </label>
        <% end %>
      </fieldset>
    <% end %>

    <% if @items.empty? %>
      <p>Esta atividade ainda não tem questões montadas.</p>
    <% else %>
      <%= submit_tag "Lançar nota", class: "button button-primary button-block" %>
    <% end %>
  <% end %>
<% else %>
  <section class="correction-card">
    <h2>Quem é o aluno?</h2>
    <p>
      <% if @lira_ready %>
        Abra esta página no Chrome ou no Safari (não na Câmera do sistema).
        Aponte para o QR pequeno do cartão-resposta; o Maestro tira a foto sozinho.
      <% else %>
        O QR escolhe o aluno. Sem OpenAI/Gemini, as bolhas você marca na tela seguinte.
      <% end %>
    </p>
    <div class="qr-scanner-card"
         data-qr-scanner
         data-correction-pin="<%= @activity.ensure_correction_pin! %>"
         <% if @lira_ready %>
           data-qr-grade
           data-scan-url="<%= gabarito_scan_path(@activity.correction_token) %>"
         <% end %>>
      <%= form_with url: gabarito_scan_path(@activity.correction_token),
                    method: :post,
                    local: true,
                    html: { multipart: true, class: "qr-photo-form" } do %>
        <label class="button button-primary button-block">
          Fotografar cartão
          <input class="visually-hidden"
                 type="file"
                 name="card"
                 accept="image/*"
                 capture="environment"
                 data-qr-file>
        </label>
      <% end %>
      <button type="button" class="button button-secondary button-block" data-qr-start>
        <%= @lira_ready ? "Usar câmera na tela" : "Ler QR da folha do aluno" %>
      </button>
      <video data-qr-video playsinline webkit-playsinline muted hidden></video>
      <p class="correction-scan-banner is-wait" data-qr-status role="status">
        Fotografe o cartão inteiro (QR + bolhas). Não use a Câmera do iPhone para abrir o site.
      </p>
      <input type="url"
             class="correction-search"
             data-qr-paste
             placeholder="Se o QR não abrir, cole o link aqui"
             autocomplete="off">
    </div>
    <input type="search"
           class="correction-search"
           data-student-filter
           placeholder="Buscar pelo nome"
           autocomplete="off">
  </section>

  <nav class="correction-students">
    <% @students.each do |student| %>
      <%= link_to gabarito_aluno_path(@activity.correction_token, student),
                  class: "correction-student",
                  data: { student_name: student.name } do %>
        <%= student.name %>
        <% if (row = @assignments_by_student&.[](student.id)) %>
          <small>folha <%= row.slot %></small>
        <% end %>
      <% end %>
    <% end %>
  </nav>
<% end %>
