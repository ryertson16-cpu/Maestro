<div class="page-header page-header-with-action">
  <div class="students-page-title">
    <%= maestro_icon :students, size: :lg %>
    <h1>Importar alunos</h1>
    <p>
      Envie um arquivo CSV para criar alunos e vinculá-los às turmas.
    </p>
  </div>

  <%= link_to "Voltar para alunos",
              students_path,
              class: "button button-secondary" %>
</div>

<section class="form-card">
  <%= form_with url: import_create_enrollments_path,
                method: :post,
                multipart: true,
                local: true do |form| %>

    <div class="form-field">
      <%= form.label :file, "Arquivo CSV" %>
      <%= form.file_field :file,
                          accept: ".csv,text/csv",
                          required: true %>
    </div>

    <p class="form-help">
      Colunas esperadas:
      nome, matricula, turma, data_matricula e status.
    </p>

    <div class="form-actions">
      <%= form.submit "Importar arquivo",
                      class: "button button-primary" %>

      <%= link_to "Cancelar",
                  students_path,
                  class: "button button-secondary" %>
    </div>
  <% end %>
</section>