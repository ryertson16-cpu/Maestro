<article class="lira-bubble lira-bubble-<%= message.role %>" id="<%= dom_id(message) %>">
  <% if message.assistant? %>
    <%= render "lira/chats/assistant_id" %>
  <% else %>
    <strong>Você</strong>
  <% end %>
  <div data-lira-copy-body>
    <%= simple_format(message.body) %>
  </div>
  <% if message.assistant? %>
    <button type="button"
            class="button button-ghost button-small lira-copy"
            data-lira-copy>
      Copiar
    </button>
  <% end %>
</article>
