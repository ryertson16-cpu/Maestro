<div class="page-header page-header-with-action">
  <div class="diary-page-title">
    <%= maestro_icon :diary, size: :lg %>
    <h1>Aulas registradas</h1>
    <p>Consulte o histórico do diário de classe.</p>
  </div>

  <%= link_to(
    "Registrar aula",
    new_lesson_path({ classroom_id: params[:classroom_id] }.compact),
    class: "button button-primary"
  ) %>
</div>

<section class="form-card lesson-pack-receiver">
  <h2>Receber aulas de outro caderno</h2>
  <p class="form-help">
    Cole o pacote copiado no outro Maestro ou envie o arquivo
    <code>.maestro.json</code>. O Maestro recria a aula, o plano, as questões,
    a frequência e as notas. Aluno novo não é criado: se o nome no pacote
    bater com um aluno já desta base, as informações vão para ele.
  </p>

  <%= form_with url: import_lessons_path,
                method: :post,
                multipart: true,
                local: true,
                html: { data: { turbo: false } } do |form| %>
    <% if @classrooms.any? %>
      <div class="form-field">
        <%= form.label :classroom_id, "Turma de destino" %>
        <%= form.select :classroom_id,
                        @classrooms.map { |classroom| [classroom.name, classroom.id] },
                        { include_blank: "Usar a turma do pacote", selected: params[:classroom_id] } %>
      </div>
    <% end %>

    <div class="form-field">
      <%= form.label :pack, "Pacote copiado" %>
      <%= form.text_area :pack,
                         rows: 6,
                         placeholder: "Cole aqui o JSON copiado no outro caderno" %>
    </div>

    <div class="form-field">
      <%= form.label :file, "Ou arquivo do pacote" %>
      <%= form.file_field :file, accept: ".json,application/json" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Receber aulas", class: "button button-primary" %>
    </div>
  <% end %>
</section>

<% if params[:classroom_id].present? && @lessons.any? %>
  <div class="lesson-pack-classroom-actions"
       data-controller="clipboard"
       data-clipboard-url-value="<%= export_lessons_path(format: :json, classroom_id: params[:classroom_id]) %>"
       data-clipboard-copied-value="Pacote da turma copiado">
    <button type="button"
            class="button button-secondary"
            data-action="clipboard#copy">
      Copiar aulas desta turma
    </button>
    <%= link_to "Baixar aulas desta turma",
                export_lessons_path(format: :json, classroom_id: params[:classroom_id], download: 1),
                class: "button button-secondary",
                data: { turbo: false } %>
  </div>
<% end %>

<% if @lessons.any? %>
  <section class="monitoring-classrooms-section" aria-label="Aulas registradas">
    <div class="lesson-list-grid">
      <% @lessons.each do |lesson| %>
        <article class="monitoring-classroom-card classroom-hub-card lesson-list-card">
          <%= link_to lesson_path(lesson), class: "classroom-hub-main" do %>
            <div class="monitoring-classroom-card-top">
              <div>
                <%= maestro_icon :diary, size: :sm %>
                <h3><%= lesson.theme %></h3>
              </div>

              <span class="monitoring-classroom-badge is-ok">
                <%= l(lesson.lesson_date, format: :short) %>
              </span>
            </div>

            <div class="monitoring-classroom-card-info">
              <span><%= lesson.classroom.name %></span>
              <span><%= lesson.course&.name || "Disciplina não informada" %></span>
              <% if lesson.siage_period.present? %>
                <span><%= lesson.siage_period %></span>
              <% end %>
              <% if lesson.activity&.activity_type.present? %>
                <span><%= lesson.activity.activity_type %></span>
              <% end %>
              <%= lesson_siage_status_badge(@siage_shipments[lesson.id]) %>
            </div>
          <% end %>

          <div class="classroom-hub-actions">
            <%= link_to(
              "Ver aula",
              lesson_path(lesson),
              class: "button button-secondary button-small"
            ) %>

            <%= link_to(
              "Frequência",
              attendance_records_path(
                classroom_id: lesson.classroom_id,
                attendance_date: lesson.lesson_date
              ),
              class: "button button-primary button-small"
            ) %>

            <%= render "lessons/pack_actions", lesson: lesson %>

            <%= render "lessons/delete_button",
                       lesson: lesson,
                       compact: true %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% else %>
  <section class="empty-state">
    <%= maestro_icon :diary %>
    <strong>Nenhuma aula registrada.</strong>
    <p>Comece registrando a primeira aula do diário.</p>

    <%= link_to(
      "Registrar primeira aula",
      new_lesson_path,
      class: "button button-primary"
    ) %>
  </section>
<% end %>
