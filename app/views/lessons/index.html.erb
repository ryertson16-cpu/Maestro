<div class="page-header page-header-with-action">
  <div class="diary-page-title">
    <%= maestro_icon :diary, size: :lg %>
    <h1>Aulas registradas</h1>
    <p>Consulte o histórico do diário de classe.</p>
  </div>

  <%= link_to(
    "Registrar aula",
    new_lesson_path({ classroom_id: params[:classroom_id] }.compact),
    class: "button button-primary"
  ) %>
</div>

<% if @lessons.any? %>
  <section class="monitoring-classrooms-section" aria-label="Aulas registradas">
    <div class="lesson-list-grid">
      <% @lessons.each do |lesson| %>
        <article class="monitoring-classroom-card classroom-hub-card lesson-list-card">
          <%= link_to lesson_path(lesson), class: "classroom-hub-main" do %>
            <div class="monitoring-classroom-card-top">
              <div>
                <%= maestro_icon :diary, size: :sm %>
                <h3><%= lesson.theme %></h3>
              </div>

              <span class="monitoring-classroom-badge is-ok">
                <%= l(lesson.lesson_date, format: :short) %>
              </span>
            </div>

            <div class="monitoring-classroom-card-info">
              <span><%= lesson.classroom.name %></span>
              <span><%= lesson.course&.name || "Disciplina não informada" %></span>
              <% if lesson.siage_period.present? %>
                <span><%= lesson.siage_period %></span>
              <% end %>
              <% if lesson.activity&.activity_type.present? %>
                <span><%= lesson.activity.activity_type %></span>
              <% end %>
            </div>
          <% end %>

          <div class="classroom-hub-actions">
            <%= link_to(
              "Ver aula",
              lesson_path(lesson),
              class: "button button-secondary button-small"
            ) %>

            <%= link_to(
              "Frequência",
              attendance_records_path(
                classroom_id: lesson.classroom_id,
                attendance_date: lesson.lesson_date
              ),
              class: "button button-primary button-small"
            ) %>

            <%= render "lessons/delete_button",
                       lesson: lesson,
                       compact: true %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% else %>
  <section class="empty-state">
    <%= maestro_icon :diary %>
    <strong>Nenhuma aula registrada.</strong>
    <p>Comece registrando a primeira aula do diário.</p>

    <%= link_to(
      "Registrar primeira aula",
      new_lesson_path,
      class: "button button-primary"
    ) %>
  </section>
<% end %>
