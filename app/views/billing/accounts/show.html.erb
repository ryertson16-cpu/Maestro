<% content_for :title, "Assinatura | Maestro" %>

<div class="page-header">
  <div>
    <h1>Assinatura</h1>
    <p>O caderno pleno no site, no PC e no WhatsApp fica liberado com a mensalidade em dia.</p>
  </div>
</div>

<section class="data-card">
  <span class="section-eyebrow">Plano</span>
  <h2>
    <% if current_professor.platform_operator? %>
      Gestor — acesso permanente
    <% else %>
      Maestro mensal — R$ <%= number_with_precision(Billing::Config::MONTHLY_PRICE, precision: 2) %>
    <% end %>
  </h2>
  <p>
    <% if @subscription %>
      Situação: <strong><%= @subscription.label %></strong>
      <% if @subscription.current_period_end.present? %>
        · válido até <%= l(@subscription.current_period_end, format: :long) %>
      <% end %>
    <% else %>
      Nenhuma assinatura nesta conta.
    <% end %>
  </p>
  <p>
    <% if current_professor.platform_operator? %>
      Conta de gestor: acesso pleno por tempo indeterminado, sem período de teste.
    <% elsif @full_access %>
      Você está usando o Maestro em sua forma plena.
    <% else %>
      Sem assinatura ativa o caderno, o WhatsApp e o atalho do PC ficam bloqueados.
    <% end %>
  </p>

  <% if @subscription&.payment_method.present? %>
    <p class="table-secondary-text">Forma: <%= @subscription.payment_label %></p>
  <% end %>

  <% unless @subscription&.complimentary? || @subscription&.active? %>
    <div class="desk-row-actions">
      <%= button_to "Assinar com PIX",
                    assinatura_path(payment_method: "pix"),
                    method: :post,
                    class: "button button-primary",
                    form: { data: { skip_confirm: true } } %>
      <%= button_to "Assinar com cartão",
                    assinatura_path(payment_method: "credit_card"),
                    method: :post,
                    class: "button button-secondary",
                    form: { data: { skip_confirm: true } } %>
    </div>
  <% end %>

  <% if @subscription&.asaas_checkout_url.present? && !@full_access %>
    <p>
      <%= link_to "Concluir pagamento no Asaas",
                  @subscription.asaas_checkout_url,
                  class: "button button-secondary",
                  target: "_blank",
                  rel: "noopener" %>
    </p>
  <% end %>
</section>
