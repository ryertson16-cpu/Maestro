<% content_for :title, "Prova | Maestro" %>

<div class="page-header">
  <h1>Prova</h1>
  <p>
    Escolha a turma e a atividade. QR, folha do aluno e correção ficam na mesma ficha.
  </p>
</div>

<% if @classrooms.blank? %>
  <section class="empty-state">
    <strong>Nenhuma turma no caderno.</strong>
    <p>Cadastre uma turma e monte a atividade para gerar o QR.</p>
  </section>
<% else %>
  <section class="data-card">
    <%= form_with url: corrections_path, method: :get, local: true, class: "question-bank-filters" do %>
      <%= select_tag :classroom_id,
                     options_from_collection_for_select(@classrooms, :id, :name, @classroom&.id),
                     required: true %>
      <% if @activities.any? %>
        <%= select_tag :activity_id,
                       options_for_select(
                         @activities.map { |activity| ["#{activity.title} · #{activity.bimester_label}", activity.id] },
                         @activity&.id
                       ) %>
      <% end %>
      <%= submit_tag "Abrir prova", class: "button button-secondary" %>
    <% end %>
  </section>

  <% if @activity.blank? %>
    <section class="empty-state">
      <strong>Não há atividade nesta turma.</strong>
      <p>Monte a prova no banco de questões para gerar o gabarito com QR.</p>
      <%= link_to "Banco de questões", questions_path, class: "button button-primary" %>
    </section>
  <% elsif !@activity.assembled? %>
    <section class="empty-state">
      <strong><%= @activity.title %> ainda não tem questões.</strong>
      <p>Inclua as questões na montagem. Sem gabarito, o celular não tem o que corrigir.</p>
      <%= link_to "Montar prova", assemble_activity_path(@activity), class: "button button-primary" %>
    </section>
  <% else %>
    <section class="data-card">
      <p class="activity-type-hint">
        QR, folha e correção desta prova estão em uma ficha só.
      </p>
      <%= link_to "Abrir prova",
                  assemble_activity_path(@activity),
                  class: "button button-primary" %>
    </section>
  <% end %>
<% end %>
