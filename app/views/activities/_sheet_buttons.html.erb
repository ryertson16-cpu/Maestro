<% css_class = local_assigns[:css_class].presence || "button button-secondary button-small" %>
<%= form_with url: sheet_activity_path(activity), method: :get, data: { turbo: false }, html: { class: "sheet-export", target: "_blank" } do %>
  <label class="sheet-export-file">
    Arquivo
    <%= select_tag :file, options_for_select([["PDF", "pdf"], ["Word", "docx"]], "pdf") %>
  </label>
  <%= submit_tag "Folha do aluno", class: css_class, title: "Cada aluno recebe questões e alternativas em ordem diferente." %>
  <%= submit_tag "Gabarito do professor", class: css_class, formaction: key_sheet_activity_path(activity) %>
<% end %>
