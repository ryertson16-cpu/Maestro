<% content_for :title, "Resultado | Maestro" %>

<div class="page-header page-header-with-action">
  <div>
    <h1>Resultado</h1>
    <p>
      <%= @activity.title %>
      —
      <%= @activity.lesson.classroom.name %>
      <% if @activity.lesson.course %>
        · <%= @activity.lesson.course.name %>
      <% end %>
      · <%= @result.objective_items.size %> questões
    </p>
  </div>
  <div class="page-header-actions">
    <%= link_to "Gabarito do professor",
                key_sheet_activity_path(@activity, format: :pdf),
                class: "button button-secondary",
                data: { turbo: false } %>
    <%= link_to "Exportar notas",
                grades_export_activity_path(@activity, format: :pdf),
                class: "button button-primary",
                data: { turbo: false } %>
  </div>
</div>

<% tabs_trailing = capture do %>
  <% if @activity.correction_closed? %>
    <p class="exam-tabs-summary">
      <%= @result.corrected_label %>
      ·
      <%= @result.missed_label %>
    </p>
  <% else %>
    <%= button_to "Correção concluída",
                  close_correction_activity_path(@activity),
                  method: :post,
                  class: "button button-primary",
                  form: { data: { turbo: false, confirm_message: "Concluir a correção? Quem entregou o gabarito fica presente nesta aula. Quem ficou sem gabarito falta a prova e fica ausente na chamada." } } %>
  <% end %>
<% end %>
<%= render "activities/exam_tabs", activity: @activity, current: :resultado, trailing: tabs_trailing %>

<section class="data-card exam-coverage <%= @activity.correction_closed? ? "is-closed" : (@result.coverage_complete? ? "is-complete" : "is-open") %>">
  <h2>
    <% if @activity.correction_closed? %>
      Correção concluída
    <% elsif @result.students.empty? %>
      Nenhum aluno nesta turma
    <% elsif @result.coverage_complete? %>
      Todos os gabaritos foram corrigidos
    <% else %>
      Ainda faltam gabaritos
    <% end %>
  </h2>
  <% if @result.students.any? %>
    <p class="activity-type-hint">
      <% if @activity.correction_closed? %>
        <%= @result.corrected_label %>. <%= @result.missed_label.capitalize %>.
      <% else %>
        <%= @result.corrected.size %> de <%= @result.students.size %> alunos com nota lançada.
      <% end %>
    </p>
    <ul class="exam-coverage-list">
      <% @result.readings.each do |row| %>
        <li>
          <span><%= row.student.name %></span>
          <% if row.submission&.score.present? %>
            <strong class="exam-coverage-mark is-done">Corrigido</strong>
          <% elsif @activity.correction_closed? || row.submission&.missed_exam? %>
            <strong class="exam-coverage-mark is-absent">Aluno faltou a prova</strong>
          <% else %>
            <strong class="exam-coverage-mark is-missing">Sem correção</strong>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="exam-stat-grid">
  <article class="exam-stat-card">
    <p>Média da turma</p>
    <strong><%= format("%.1f", @result.average).tr(".", ",") %></strong>
  </article>
  <article class="exam-stat-card">
    <p>Nota 7 ou mais</p>
    <strong><%= @result.pass_percent %>%</strong>
    <span><%= @result.pass_count %> de <%= @result.students.size %> alunos</span>
  </article>
  <article class="exam-stat-card">
    <p>Maior e menor</p>
    <strong>
      <%= @result.high_reading ? format("%.1f", @result.high_reading.submission.score).tr(".", ",") : "—" %>
      ·
      <%= @result.low_reading ? format("%.1f", @result.low_reading.submission.score).tr(".", ",") : "—" %>
    </strong>
    <span>
      <%= [ @result.high_reading&.student&.name, @result.low_reading&.student&.name ].compact.join(" e ") %>
    </span>
  </article>
  <article class="exam-stat-card">
    <p>Mais errada</p>
    <% if (hard = @result.hardest) %>
      <strong><%= hard.label %></strong>
      <span><%= hard.rate %>% acertaram</span>
    <% else %>
      <strong>—</strong>
    <% end %>
  </article>
</section>

<section class="data-card">
  <div class="page-header page-header-with-action">
    <div>
      <h2>Alunos identificados</h2>
      <p class="activity-type-hint">
        Verde na foto: pintou a certa. Vermelho: a certa ficou vazia. Azul: questão em branco.
      </p>
    </div>
    <% if @result.identified.any? %>
      <%= button_to "Apagar correção",
                    clear_results_activity_path(@activity),
                    method: :delete,
                    class: "button button-danger",
                    form: { data: { turbo: false, confirm_message: "Apagar as notas e os cartões lidos desta prova?" } } %>
    <% end %>
  </div>
  <% if @result.identified.any? %>
    <div class="exam-identified">
      <% @result.identified.each do |row| %>
        <article class="exam-identified-row">
          <div class="exam-identified-thumb">
            <% if row.submission&.marked_photo&.attached? %>
              <%= image_tag url_for(row.submission.marked_photo), alt: "Cartão de #{row.student.name}" %>
            <% elsif row.submission&.card_photo&.attached? %>
              <%= image_tag url_for(row.submission.card_photo), alt: "Cartão de #{row.student.name}" %>
            <% else %>
              <span>Cartão</span>
            <% end %>
          </div>
          <div>
            <strong><%= row.student.name %></strong>
            <p class="exam-identified-status">Identificado · <%= row.hits %> de <%= row.objective_count %></p>
          </div>
          <div class="exam-identified-side">
            <div class="exam-identified-score">
              <%= row.submission&.score.present? ? format("%.1f", row.submission.score).tr(".", ",") : "—" %>
            </div>
            <div class="exam-identified-actions">
              <%= link_to "Editar acertos",
                          edit_result_activity_path(@activity, student_id: row.student),
                          class: "button button-secondary" %>
              <%= button_to "Apagar",
                            clear_student_result_activity_path(@activity, student_id: row.student),
                            method: :delete,
                            class: "button button-danger",
                            form: { data: { turbo: false, confirm_message: "Apagar a correção de #{row.student.name}?" } } %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p>Ainda não há cartão lido. Abra a correção no celular e aponte para o QR.</p>
  <% end %>
</section>

<section class="data-card">
  <h2>Resultado por questão</h2>
  <p class="activity-type-hint">
    O número é o da questão no banco desta prova, não a ordem impressa na folha de cada aluno.
  </p>
  <% if @result.item_stats.any? %>
    <div class="exam-item-grid">
      <% @result.item_stats.each do |stat| %>
        <%= link_to question_result_activity_path(@activity, question_id: stat.item.id),
                    class: [ "exam-item-stat", ("is-low" if stat.rate < 50) ].compact.join(" ") do %>
          <strong><%= stat.label %></strong>
          <span><%= stat.rate %>%</span>
          <div class="exam-item-bar" style="--rate: <%= stat.rate %>%"></div>
        <% end %>
      <% end %>
    </div>
    <% if (hard = @result.hardest) %>
      <p class="activity-type-hint">
        <%= hard.label %> · <%= truncate(hard.prompt, length: 120) %>
        Gabarito <%= hard.item.correct_letter %>.
        <% if hard.wrong_letter.present? %>
          <%= hard.rate %>% acertaram.
          Entre quem errou, a mais marcada foi <%= hard.wrong_letter %>.
        <% end %>
      </p>
    <% end %>
  <% else %>
    <p>Monte as questões objetivas para ver o índice de acertos.</p>
  <% end %>
</section>
