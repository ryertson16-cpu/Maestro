<% content_for :title, "Prova | Maestro" %>
<% if @correction_url.blank? && !Corrections::PhoneLink.failed? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="4">
  <% end %>
<% end %>

<div class="page-header page-header-with-action">
  <div>
    <h1>Prova</h1>
    <p>
      <%= @activity.title %>
      —
      <%= @activity.lesson.classroom.name %>
      <% if @activity.lesson.course %>
        · <%= @activity.lesson.course.name %>
      <% end %>
    </p>
  </div>
  <div class="page-header-actions">
    <%= render "activities/sheet_buttons", activity: @activity %>
    <%= link_to "Resultado",
                results_activity_path(@activity),
                class: "button button-secondary" %>
    <%= link_to "Corrigir no celular",
                open_gabarito_activity_path(@activity),
                class: "button button-primary",
                target: "_blank",
                rel: "noopener" %>
  </div>
</div>

<%= render "activities/exam_tabs", activity: @activity, current: :prova %>

<section class="data-card">
  <h2>QR do gabarito</h2>
  <p class="activity-type-hint">
    A correção no celular funciona como nas plataformas de gabarito por foto:
    o professor abre o link HTTPS no Chrome ou no Safari e fotografa o cartão.
    A Câmera do iPhone não serve para abrir o site — ela trava em tela preta no IP local.
  </p>
  <% unless @lira_ready %>
    <p class="correction-flash is-warn">
      O Maestro está sem OpenAI/Gemini neste caderno. O QR abre a correção no celular,
      mas as bolhas você marca na tela. Para ler o cartão sozinho, ligue a chave em .env.
    </p>
  <% end %>
  <% if @correction_url.blank? %>
    <p class="correction-flash is-warn">
      <% if Corrections::PhoneLink.failed? %>
        Não consegui gerar o link HTTPS do celular. Toque em Atualizar QR e espere
        o código aparecer. Enquanto o QR for o IP do computador, a câmera fica preta.
      <% else %>
        O Maestro está gerando o link HTTPS. Espere o QR aparecer — não aponte a
        câmera ainda. Se apontar para o IP local, a tela fica preta.
      <% end %>
    </p>
  <% end %>
  <p>
    <%= link_to "Atualizar QR",
                assemble_activity_path(@activity, refresh_phone_link: 1),
                class: "button button-secondary" %>
  </p>
  <% if @correction_url.present? && https_correction_host? %>
    <div class="gabarito-qr">
      <%= raw RQRCode::QRCode.new(@correction_url).as_svg(module_size: 8, viewbox: true) %>
    </div>
    <p class="activity-type-hint">
      No celular, abra o Chrome ou o Safari e cole este link. Depois toque em Fotografar cartão.
    </p>
    <code><%= @correction_url %></code>
  <% end %>
</section>

<section class="data-card">
  <h2>Montar prova</h2>
  <p class="activity-type-hint">
    Informe o assunto e a quantidade. O Maestro puxa do seu banco e, se faltar,
    escreve objetivas A–E. Depois você revisa, retira e reordena.
    <% unless @lira_ready %>
      Sem OpenAI/Gemini, só entra o que já está no banco.
    <% end %>
  </p>
  <%= form_with url: build_exam_activity_path(@activity), method: :post, local: true, class: "question-bank-filters" do %>
    <%= text_field_tag :topic, params[:topic], placeholder: "Assunto, ex.: função do 2º grau", required: true %>
    <%= number_field_tag :quantity, params[:quantity].presence || 10, min: 1, max: 40, step: 1 %>
    <%= select_tag :course_id,
                   options_from_collection_for_select(@courses, :id, :name, params[:course_id].presence || @activity.lesson.course_id),
                   include_blank: "Disciplina da turma" %>
    <%= select_tag :mix,
                   options_for_select([["Só objetivas", "objective"], ["Banco misto (o Maestro só objetiva)", "mixed"]], params[:mix]) %>
    <%= text_field_tag :difficulty, params[:difficulty], placeholder: "Nível, ex.: 3ª série" %>
    <%= submit_tag "Montar", class: "button button-primary" %>
  <% end %>
</section>

<section class="data-card">
  <h2>Questões desta atividade</h2>
  <p class="activity-type-hint">
    O PDF traz as questões e, à parte, o cartão-resposta com QR grande e bolhas vazias.
  </p>

  <% if @items.any? %>
    <ol class="assembled-questions">
      <% @items.each do |item| %>
        <li>
          <div class="assembled-question-body">
            <strong><%= item.prompt %></strong>
            <%= render "questions/figure", image: item.image %>
            <div class="activity-type-hint">
              <%= item.objective? ? "Objetiva · gabarito #{item.correct_letter}" : "Discursiva" %>
              · <%= format("%.1f", item.points).tr(".", ",") %> pt
              <% if item.bncc_skill.present? %>
                · BNCC <%= item.bncc_skill %>
              <% end %>
            </div>
          </div>
          <div class="page-header-actions">
            <%= button_to "↑",
                          move_activity_activity_question_path(@activity, item, direction: "up"),
                          method: :patch,
                          class: "button button-secondary button-small",
                          disabled: item.position <= 1 %>
            <%= button_to "↓",
                          move_activity_activity_question_path(@activity, item, direction: "down"),
                          method: :patch,
                          class: "button button-secondary button-small" %>
            <%= button_to "Retirar",
                          activity_activity_question_path(@activity, item),
                          method: :delete,
                          class: "button button-secondary button-small",
                          data: { turbo_confirm: "Retirar esta questão da atividade?" } %>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p>Ainda não há questões. Escolha no banco abaixo.</p>
  <% end %>
</section>

<% if @exam_assignments.present? %>
  <section class="data-card">
    <h2>Folhas da turma</h2>
    <p class="activity-type-hint">
      A folha do aluno não traz o grupo. O QR e esta lista dizem ao professor qual embaralhamento cada um recebeu.
    </p>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Aluno</th>
            <th>Folha</th>
          </tr>
        </thead>
        <tbody>
          <% @exam_assignments.sort_by { |row| row.student.name.to_s }.each do |row| %>
            <tr>
              <td><%= row.student.name %></td>
              <td><%= row.slot %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<section class="data-card">
  <h2>Banco próprio</h2>
  <%= form_with url: assemble_activity_path(@activity), method: :get, local: true, class: "question-bank-filters" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Buscar no banco" %>
    <%= select_tag :kind,
                   options_for_select([["Todos os tipos", ""]] + Question::KINDS.map { |value, label| [label, value] }, params[:kind]) %>
    <%= select_tag :course_id,
                   options_from_collection_for_select(@courses, :id, :name, params[:course_id]),
                   include_blank: "Qualquer disciplina" %>
    <%= submit_tag "Filtrar", class: "button button-secondary" %>
    <%= link_to "Nova questão", new_question_path, class: "button button-secondary" %>
  <% end %>

  <% if @bank.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Questão</th>
            <th>Tipo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @bank.each do |question| %>
            <tr>
              <td>
                <%= truncate(question.prompt, length: 160) %>
                <% if question.image.attached? %>
                  <div class="activity-type-hint">Com figura</div>
                <% end %>
                <% if question.tag.present? || question.bncc_skill.present? %>
                  <div class="activity-type-hint">
                    <%= [question.bncc_skill.presence, question.tag.presence].compact.join(" · ") %>
                  </div>
                <% end %>
              </td>
              <td><%= question.kind_label %></td>
              <td>
                <%= button_to "Incluir",
                              activity_activity_questions_path(@activity, question_id: question.id),
                              method: :post,
                              class: "button button-primary button-small" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>Não há questões disponíveis neste filtro.</p>
  <% end %>
</section>

<% if @card_readings&.any? { |row| row.marked_photo.attached? || row.card_photo.attached? } %>
  <section class="data-card">
    <h2>Cartões lidos</h2>
    <p class="activity-type-hint card-reading-legend">
      Verde: pintou a certa. Vermelho: a certa ficou vazia. Azul: questão em branco.
      A foto fica no caderno, não no celular.
    </p>
    <div class="card-readings">
      <% @card_readings.each do |row| %>
        <% next unless row.marked_photo.attached? || row.card_photo.attached? %>
        <article>
          <strong><%= row.student.name %></strong>
          <span class="activity-type-hint">nota <%= format("%.1f", row.score.to_f).tr(".", ",") %></span>
          <div class="card-reading-photo">
            <%= image_tag url_for(row.marked_photo.attached? ? row.marked_photo : row.card_photo),
                          alt: "Cartão de #{row.student.name}" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "activities/card_intake",
           activity: @activity,
           pending_cards: @pending_cards,
           students: @students %>
