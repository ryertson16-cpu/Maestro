<!DOCTYPE html>
<html class="correction-html" lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Corrigir | Maestro" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#5b4bdb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="/vendor/jsqr.min.js"></script>
    <%= javascript_importmap_tags "correction_page" %>
  </head>
  <body class="correction-body">
    <main class="correction-shell">
      <% if notice.present? %>
        <p class="correction-flash is-ok"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="correction-flash is-warn"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
