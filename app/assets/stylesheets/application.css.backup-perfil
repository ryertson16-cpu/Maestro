/*
 * This is a manifest file that'll be compiled into application.css.
 *
 * With Propshaft, assets are served efficiently without preprocessing steps. You can still include
 * application-wide styles in this file, but keep in mind that CSS precedence will follow the standard
 * cascading order, meaning styles declared later in the document or manifest will override earlier ones,
 * depending on specificity.
 *
 * Consider organizing styles into separate files for maintainability.
 */
/*
 * Maestro — identidade visual global
 */

:root {
  --color-primary: #5b4bdb;
  --color-primary-dark: #4638b5;
  --color-primary-light: #eeecff;

  --color-background: #f5f7fb;
  --color-surface: #ffffff;
  --color-surface-muted: #f8f9fc;

  --color-text: #20263d;
  --color-text-muted: #707891;
  --color-border: #e5e8f0;

  --color-success: #159570;
  --color-success-light: #e7f8f1;
  --color-danger: #d84d68;
  --color-danger-light: #fff0f3;
  --color-warning: #b47b10;
  --color-warning-light: #fff8e5;

  --shadow-card: 0 12px 30px rgba(32, 38, 61, 0.07);
  --shadow-small: 0 4px 12px rgba(32, 38, 61, 0.08);

  --radius-small: 8px;
  --radius-medium: 14px;
  --radius-large: 20px;
}

/* Base */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--color-background);
  color: var(--color-text);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.6;
}

a {
  color: var(--color-primary);
  text-decoration: none;
  transition: color 0.2s ease, opacity 0.2s ease;
}

a:hover {
  color: var(--color-primary-dark);
}

h1,
h2,
h3,
h4 {
  margin-top: 0;
  color: var(--color-text);
  line-height: 1.25;
}

h1 {
  margin-bottom: 8px;
  font-size: clamp(1.7rem, 3vw, 2.35rem);
  letter-spacing: -0.04em;
}

h2 {
  margin-bottom: 18px;
  font-size: 1.25rem;
  letter-spacing: -0.02em;
}

p {
  color: var(--color-text-muted);
}

hr {
  margin: 28px 0;
  border: 0;
  border-top: 1px solid var(--color-border);
}

/* Layout principal */

.app-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid var(--color-border);
  backdrop-filter: blur(14px);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 28px;
  width: min(1380px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;
}

.brand {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10px;
  color: var(--color-text);
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: -0.03em;
}

.brand:hover {
  color: var(--color-text);
}

.brand-mark {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--color-primary), #8a79ff);
  color: white;
  box-shadow: 0 7px 15px rgba(91, 75, 219, 0.28);
  font-size: 1.25rem;
  font-weight: 800;
}

.main-nav {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.nav-link {
  padding: 9px 11px;
  border-radius: 8px;
  color: var(--color-text-muted);
  font-size: 0.88rem;
  font-weight: 600;
  white-space: nowrap;
}

.nav-link:hover {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.header-user {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.user-email {
  max-width: 190px;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 0.78rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-main {
  min-height: calc(100vh - 140px);
  padding: 42px 0 64px;
}

.page-shell {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.app-footer {
  display: flex;
  justify-content: space-between;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 22px 0 30px;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-size: 0.8rem;
}

/* Cabeçalhos de páginas */

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.page-header p {
  margin: 0;
}

.page-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

/* Cards */

.card,
.attendance-filter,
.attendance-list,
.dashboard-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-large);
  box-shadow: var(--shadow-card);
}

.card,
.dashboard-card {
  padding: 25px;
}

.dashboard-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 24px;
  padding: clamp(26px, 5vw, 46px);
  border-radius: var(--radius-large);
  background: linear-gradient(135deg, #5041c9 0%, #7768e7 60%, #9284f5 100%);
  color: white;
  box-shadow: 0 16px 30px rgba(91, 75, 219, 0.22);
}

.dashboard-hero::after {
  position: absolute;
  right: -60px;
  bottom: -90px;
  width: 260px;
  height: 260px;
  border: 35px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  content: "";
}

.dashboard-hero h1,
.dashboard-hero p {
  position: relative;
  z-index: 1;
  color: white;
}

.dashboard-hero h1 {
  margin-bottom: 10px;
}

.dashboard-hero p {
  margin-bottom: 0;
  opacity: 0.85;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.dashboard-card {
  display: flex;
  min-height: 150px;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.dashboard-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 30px rgba(32, 38, 61, 0.11);
}

.dashboard-card-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  margin-bottom: 17px;
  border-radius: 12px;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 1.15rem;
  font-weight: 800;
}

.dashboard-card h2 {
  margin-bottom: 5px;
  font-size: 1.05rem;
}

.dashboard-card p {
  margin: 0 0 16px;
  font-size: 0.88rem;
}

.dashboard-card-link {
  font-size: 0.86rem;
  font-weight: 700;
}

/* Botões */

.button,
button,
input[type="submit"] {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  padding: 10px 17px;
  border: 0;
  border-radius: var(--radius-small);
  background: var(--color-primary);
  color: white;
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.button:hover,
button:hover,
input[type="submit"]:hover {
  background: var(--color-primary-dark);
  color: white;
  box-shadow: var(--shadow-small);
  transform: translateY(-1px);
}

.button-secondary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.button-secondary:hover {
  background: #dfdcff;
  color: var(--color-primary-dark);
}

.button-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.button-danger:hover {
  background: #ffdae2;
  color: var(--color-danger);
}

.button-ghost {
  min-height: 34px;
  padding: 6px 12px;
  background: transparent;
  color: var(--color-text-muted);
}

.button-ghost:hover {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.button-small {
  font-size: 0.8rem;
}

/* Formulários */

form {
  max-width: 100%;
}

label {
  display: block;
  margin-bottom: 7px;
  color: var(--color-text);
  font-size: 0.86rem;
  font-weight: 700;
}

input:not([type="submit"]):not([type="hidden"]),
select,
textarea {
  width: 100%;
  min-height: 44px;
  padding: 10px 13px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-small);
  outline: none;
  background: white;
  color: var(--color-text);
  font: inherit;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

input:not([type="submit"]):focus,
select:focus,
textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(91, 75, 219, 0.12);
}

.field,
.form-group {
  margin-bottom: 18px;
}

.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 24px;
}

/* Tabelas */

table {
  width: 100%;
  border-collapse: collapse;
  overflow: hidden;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
}

th {
  padding: 14px 16px;
  background: var(--color-surface-muted);
  color: var(--color-text-muted);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-align: left;
  text-transform: uppercase;
}

td {
  padding: 15px 16px;
  border-top: 1px solid var(--color-border);
  color: var(--color-text);
  vertical-align: middle;
}

tr:hover td {
  background: #fbfbfe;
}

td form {
  display: inline;
}

td input[type="submit"],
td button {
  min-height: 34px;
  padding: 6px 11px;
  font-size: 0.78rem;
}

/* Listas e páginas de cadastro */

ul {
  padding-left: 20px;
}

.page-shell > ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.page-shell > ul > li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 10px;
  padding: 17px 20px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  background: white;
  box-shadow: var(--shadow-small);
}

.page-shell > ul > li form {
  display: inline;
}

/* Diário de classe */

.attendance-filter,
.attendance-list {
  margin-top: 24px;
  padding: clamp(20px, 4vw, 30px);
}

.attendance-filter form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(180px, 0.5fr) auto;
  align-items: end;
  gap: 16px;
}

.attendance-filter form > div {
  min-width: 0;
}

.attendance-list h2 {
  margin-bottom: 22px;
}

.attendance-list table {
  margin-bottom: 22px;
}

.attendance-list input[type="text"] {
  min-width: 180px;
}

/* Mensagens */

.flash {
  margin-bottom: 22px;
  padding: 14px 17px;
  border: 1px solid transparent;
  border-radius: var(--radius-small);
  font-weight: 600;
}

.flash-success {
  border-color: #bcebdd;
  background: var(--color-success-light);
  color: var(--color-success);
}

.flash-alert {
  border-color: #ffc8d3;
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* Responsividade */

@media (max-width: 1050px) {
  .header-inner {
    flex-wrap: wrap;
    gap: 12px 18px;
    padding: 14px 0;
  }

  .main-nav {
    order: 3;
    flex-basis: 100%;
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .header-user {
    margin-left: auto;
  }
}

@media (max-width: 760px) {
  .header-inner,
  .page-shell,
  .app-footer {
    width: min(100% - 28px, 620px);
  }

  .app-main {
    padding: 28px 0 45px;
  }

  .page-header {
    flex-direction: column;
    margin-bottom: 22px;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .attendance-filter form {
    grid-template-columns: 1fr;
  }

  .app-footer {
    flex-direction: column;
    gap: 5px;
  }

  .user-email {
    display: none;
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  .page-shell > ul > li {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  h1 {
    font-size: 1.75rem;
  }

  .brand-name {
    display: none;
  }

  .main-nav {
    gap: 2px;
  }

  .nav-link {
    padding: 8px 9px;
    font-size: 0.78rem;
  }

  .dashboard-hero {
    padding: 25px 21px;
  }

  .card,
  .dashboard-card,
  .attendance-filter,
  .attendance-list {
    padding: 20px;
  }

  /* Melhorias do diário de classe */

.attendance-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-top: 30px;
}

.attendance-heading h2 {
  margin-bottom: 4px;
}

.attendance-heading p,
.attendance-list-header p {
  margin: 0;
}

.attendance-summary {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
  margin: 20px 0;
}

.summary-card {
  display: flex;
  min-height: 94px;
  flex-direction: column;
  justify-content: space-between;
  padding: 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
  box-shadow: var(--shadow-small);
}

.summary-card strong {
  font-size: 1.8rem;
  line-height: 1;
}

.summary-label {
  color: var(--color-text-muted);
  font-size: 0.76rem;
  font-weight: 800;
  text-transform: uppercase;
}

.summary-total strong {
  color: var(--color-primary);
}

.summary-present {
  border-color: #bcebdd;
  background: var(--color-success-light);
}

.summary-present strong {
  color: var(--color-success);
}

.summary-absent {
  border-color: #ffc8d3;
  background: var(--color-danger-light);
}

.summary-absent strong {
  color: var(--color-danger);
}

.summary-justified {
  border-color: #d7d2ff;
  background: var(--color-primary-light);
}

.summary-justified strong {
  color: var(--color-primary);
}

.summary-late {
  border-color: #f3dfaa;
  background: var(--color-warning-light);
}

.summary-late strong {
  color: var(--color-warning);
}

.summary-pending {
  background: var(--color-surface-muted);
}

.summary-pending strong {
  color: var(--color-text-muted);
}

.attendance-list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.attendance-status-filter {
  display: flex;
  align-items: flex-end;
  gap: 10px;
}

.attendance-status-filter label {
  margin-bottom: 7px;
  white-space: nowrap;
}

.attendance-status-filter select {
  min-width: 170px;
}

.attendance-table-wrapper {
  overflow-x: auto;
}

.attendance-status-select {
  min-width: 150px;
}

.attendance-notes-input {
  min-width: 220px;
}

.pending-label {
  display: block;
  margin-top: 4px;
  color: var(--color-warning);
  font-size: 0.75rem;
}

.attendance-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 22px;
}

.attendance-help {
  color: var(--color-text-muted);
  font-size: 0.86rem;
}

.empty-state {
  padding: 32px 20px;
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface-muted);
  text-align: center;
}

.empty-state strong {
  display: block;
  margin-bottom: 5px;
}

.empty-state p {
  margin-top: 0;
}

@media (max-width: 1050px) {
  .attendance-summary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .attendance-heading,
  .attendance-list-header,
  .attendance-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .attendance-status-filter {
    align-items: stretch;
    flex-direction: column;
    gap: 0;
  }

  .attendance-status-filter label {
    margin-bottom: 7px;
  }

  .attendance-status-filter select {
    width: 100%;
  }

  .attendance-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .attendance-actions input[type="submit"] {
    width: 100%;
  }
}
}


.profile-page {
  max-width: 920px;
  margin: 0 auto;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 32px;
  margin-bottom: 32px;
}

.profile-photo-area {
  width: 180px;
  text-align: center;
  flex-shrink: 0;
}

.profile-photo-placeholder {
  width: 132px;
  height: 132px;
  margin: 0 auto 12px;
  border: 3px solid #d9e0eb;
  border-radius: 50%;
  background: #eef2f8;
  color: #172d52;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52px;
  font-weight: 700;
}

.profile-photo-label {
  margin: 0 0 12px;
  color: #64748b;
  font-size: 14px;
}

.profile-photo-button {
  width: 100%;
  cursor: not-allowed;
  opacity: 0.75;
}

.profile-header-content h1 {
  margin-top: 0;
  margin-bottom: 20px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 18px;
  border: 0;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button-primary {
  background: #4f46e5;
  color: #ffffff;
}

.button-primary:hover {
  background: #4338ca;
  color: #ffffff;
}

.button-secondary {
  background: #e8edf5;
  color: #172d52;
}

.button-secondary:hover {
  background: #dce4f0;
  color: #172d52;
}

.profile-card {
  margin-bottom: 28px;
  padding: 28px;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(23, 45, 82, 0.06);
}

.profile-card h2 {
  margin-top: 0;
  color: #172d52;
}

.profile-details {
  margin: 0;
}

.profile-details > div {
  padding: 14px 0;
  border-bottom: 1px solid #edf1f6;
}

.profile-details > div:last-child {
  border-bottom: 0;
}

.profile-details dt {
  margin-bottom: 5px;
  color: #64748b;
  font-size: 14px;
  font-weight: 600;
}

.profile-details dd {
  margin: 0;
  color: #172d52;
  font-size: 16px;
}

.profile-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.profile-section-header h2 {
  margin-bottom: 6px;
}

.profile-section-header p {
  margin-top: 0;
  color: #64748b;
}

.course-list {
  display: grid;
  gap: 12px;
}

.course-item {
  padding: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
}

.course-item strong,
.course-item span {
  display: block;
}

.course-item strong {
  color: #172d52;
}

.course-item span {
  margin-top: 5px;
  color: #64748b;
}

.profile-empty-state {
  padding: 24px;
  border-radius: 8px;
  background: #f8fafc;
  text-align: center;
}

.profile-empty-state p {
  margin-top: 0;
  color: #64748b;
}

@media (max-width: 640px) {
  .profile-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .profile-photo-area {
    width: 100%;
  }

  .profile-section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .profile-section-header .button {
    width: 100%;
  }
}
